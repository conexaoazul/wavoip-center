# Node
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL="file:./dev.db"

# Baileys
SESSIONS_DIR=./.sessions
BAILEYS_LIB=v7

# Wavoip
WAVOIP_API_BASE_URL=https://api.wavoip.com
WAVOIP_POLL_INTERVAL_MS=5000

# i18n
DEFAULT_LOCALE=pt-BR
SUPPORTED_LOCALES=pt-BR,en-US

# PABX
REJECT_CALLS_DEFAULT=true
CALL_REJECT_MESSAGE_PT="As chamadas de voz e video estao desabilitadas para esse WhatsApp. Por favor, envie uma mensagem de texto."
CALL_REJECT_MESSAGE_EN="Voice and video calls are disabled for this WhatsApp. Please send a text message."

# IVR
IVR_TIMEOUT_SECONDS=60

# Socket.IO
CORS_ORIGIN=*

# Internal Conexao Azul Blue Voice -> n8n (default OFF; no production dispatch)
BLUE_VOICE_EVENTS_ENABLED=false
# Configure only after QA, e.g. https://conector.conexaoazul.com/webhook/<approved-path>
# BLUE_VOICE_EVENTS_URL=
# Dedicated HTTP header secret (managed outside git; never use JWT_SECRET)
# BLUE_VOICE_EVENTS_TOKEN=
