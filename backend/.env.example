# Node
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Logging
LOG_LEVEL=info

# Database
DATABASE_URL="file:./dev.db"

# Baileys
SESSIONS_DIR=./.sessions
BAILEYS_LIB=v7

# Wavoip
WAVOIP_API_BASE_URL=https://api.wavoip.com
WAVOIP_POLL_INTERVAL_MS=5000

# i18n
DEFAULT_LOCALE=pt-BR
SUPPORTED_LOCALES=pt-BR,en-US

# PABX
REJECT_CALLS_DEFAULT=true
CALL_REJECT_MESSAGE_PT="As chamadas de voz e video estao desabilitadas para esse WhatsApp. Por favor, envie uma mensagem de texto."
CALL_REJECT_MESSAGE_EN="Voice and video calls are disabled for this WhatsApp. Please send a text message."

# IVR
IVR_TIMEOUT_SECONDS=60

# Socket.IO
CORS_ORIGIN=*

# Dedicated server-side secret for sensitive recordings and transcripts.
# Leave unset until consumers, authenticated playback and vault are homologated.
# Sensitive endpoints deny access when unset (intentional fail-closed).
# PABX_SENSITIVE_API_TOKEN=YOUR_VAULT_MANAGED_32_PLUS_CHAR_TOKEN
