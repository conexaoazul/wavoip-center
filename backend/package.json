{
  "name": "wavoip-pabx",
  "version": "0.1.0",
  "private": true,
  "description": "PABX em Node.js com Baileys v7 e Wavoip - recebe chamadas WhatsApp e dispara automacoes",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:voice-bridge": "tsx --test src/blueVoice/eventBridge.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^8.0.4",
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^6.1.0",
    "axios": "^1.7.9",
    "baileys-v7": "npm:@whiskeysockets/baileys@7.0.0-rc11",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "form-data": "^4.0.5",
    "i18next": "^24.2.0",
    "node-cache": "^5.1.2",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "socket.io": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
